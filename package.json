{
  "name": "saucedemo-playwright",
  "version": "1.0.0",
  "description": "Desafio técnico QA Automation - fluxo de compra no SauceDemo com Playwright, POM e keywords customizadas",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["playwright", "qa", "automation", "page-object-model", "saucedemo"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
